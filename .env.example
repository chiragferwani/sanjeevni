# Environment variables for the Sanjeevani challenge

# Provider selection: "auto" (default, prefers local Ollama), "ollama", or "groq"
LLM_PROVIDER=auto

# Local Ollama Settings (No API key required)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:latest

# Optional Cloud Groq API Key (If you wish to use Groq cloud inference)
GROQ_API_KEY=

# Optional: Override the secret challenge flag
SECRET_FLAG=KCTF{s4njeev4n1_vidy4_3b8428a850dd}
